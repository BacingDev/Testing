# Production environment variables
# Copy to .env.production di VPS dan isi nilai sebenarnya

# Public URL aplikasi (digunakan untuk canonical URL, og:image, dll)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# URL backend FastAPI (untuk auth/api nanti jika diaktifkan kembali)
# Format: http://host.docker.internal:8000/api/v1  (kalau backend di host yg sama)
# Atau: http://backend-service:8000/api/v1 (kalau backend di container terpisah)
AUTH_API_URL=http://host.docker.internal:8000/api/v1

# Path health check backend yang dipanggil navbar (lewat gateway nginx).
# Default: /api/backend/health — biasanya tidak perlu diubah.
# NEXT_PUBLIC_BACKEND_HEALTH_PATH=/api/backend/health